{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Postgres Studio",
  "mainBinaryName": "postgres-studio",
  "version": "0.2.0",
  "identifier": "com.edneymesquita.postgres-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Postgres Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "backgroundColor": "#1e1f22"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "upgradeCode": "07f6d9ef-3cf8-52c4-80d5-11249128b1e4"
      }
    }
  }
}
